<?xml version="1.0" encoding="utf-8"?>
<!-- Slate's flat 3dp progress line: grey track, accent fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/widget_line" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/widget_accent" /><corners android:radius="2dp" /></shape></clip>
    </item>
</layer-list>
