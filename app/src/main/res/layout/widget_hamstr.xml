<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews uses framework ImageView: android:tint is required here, not AppCompat's app:tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_mark"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_600"
            android:text="Hamstr"
            android:textColor="@color/widget_ink"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/widget_paste"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/sc_paste_short"
            android:padding="10dp"
            android:src="@drawable/ic_content_paste"
            android:tint="@color/widget_ink" />

        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_accent"
            android:contentDescription="@string/sc_add_short"
            android:padding="9dp"
            android:src="@drawable/ic_add"
            android:tint="#FF14100A" />
    </LinearLayout>

    <!-- Plain View isn't allowed in RemoteViews; an empty FrameLayout pushes the status down. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/inter_600"
        android:maxLines="1"
        android:text="0 B stashed"
        android:textColor="@color/widget_ink"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/widget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/jetbrains_mono_400"
        android:maxLines="1"
        android:text="Share a link to start"
        android:textColor="@color/widget_ghost"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progressDrawable="@drawable/widget_progress"
        android:visibility="gone" />
</LinearLayout>
