<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon. Each one opens MainActivity with an action it handles. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="paste"
        android:enabled="true"
        android:icon="@drawable/sc_paste"
        android:shortcutShortLabel="@string/sc_paste_short"
        android:shortcutLongLabel="@string/sc_paste_long">
        <intent
            android:action="app.hamstr.action.PASTE"
            android:targetPackage="app.hamstr"
            android:targetClass="app.hamstr.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="add"
        android:enabled="true"
        android:icon="@drawable/sc_add"
        android:shortcutShortLabel="@string/sc_add_short"
        android:shortcutLongLabel="@string/sc_add_long">
        <intent
            android:action="app.hamstr.action.ADD"
            android:targetPackage="app.hamstr"
            android:targetClass="app.hamstr.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="library"
        android:enabled="true"
        android:icon="@drawable/sc_library"
        android:shortcutShortLabel="@string/sc_library_short"
        android:shortcutLongLabel="@string/sc_library_long">
        <intent
            android:action="app.hamstr.action.LIBRARY"
            android:targetPackage="app.hamstr"
            android:targetClass="app.hamstr.MainActivity" />
    </shortcut>
</shortcuts>
