<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same as backup_rules.xml, for cloud backups and for moving to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nearby.xml" />
        <exclude domain="file" path="nearby.json" />
        <exclude domain="file" path="nearby.json.bak" />
        <exclude domain="file" path="nearby-inbox" />
        <exclude domain="external" path="nearby-inbox" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nearby.xml" />
        <exclude domain="file" path="nearby.json" />
        <exclude domain="file" path="nearby.json.bak" />
        <exclude domain="file" path="nearby-inbox" />
        <exclude domain="external" path="nearby-inbox" />
    </device-transfer>
</data-extraction-rules>
